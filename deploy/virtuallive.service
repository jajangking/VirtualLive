[Unit]
Description=VirtualLive Neon Circuit web app
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/virtuallive
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=@NODE_BIN@ /opt/virtuallive/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
